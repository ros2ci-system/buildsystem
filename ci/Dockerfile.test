# Runs the checks and tests for the whole workspace.
#
#   docker build -f ci/Dockerfile.test -t buildsystem-test .
#   docker run --rm buildsystem-test
#
# Some tests need a service and are skipped unless told where it is:
#
#   CI_CONTAINER_RUNTIME  a container runtime's socket, for the agent tests
#   CI_POSTGRES_URL       a PostgreSQL server, for the database client tests
#
# For example, with Docker:
#
#   docker run -d --name test-postgres --network host \
#       -e POSTGRES_PASSWORD=test docker.io/library/postgres:17
#   docker run --rm --network host \
#       -v /var/run/docker.sock:/var/run/docker.sock \
#       -e CI_CONTAINER_RUNTIME=unix:///var/run/docker.sock \
#       -e CI_POSTGRES_URL=postgres://postgres:test@127.0.0.1:5432/postgres \
#       buildsystem-test
#
# Podman works the same way with its own socket path.

FROM docker.io/library/rust:1.99-slim

# The slim image leaves these out.
RUN rustup component add rustfmt clippy

WORKDIR /src
COPY . .

# Third-party crates (rustls and what it needs) are downloaded here, once.
# Everything after this line works without the network.
RUN cargo fetch --locked

# Compile at image build time, so that running the image only runs tests.
RUN cargo build --workspace --all-targets --locked --offline

CMD ["sh", "-ec", "\
    cargo fmt --all --check && \
    cargo clippy --workspace --all-targets --locked --offline -- -D warnings && \
    cargo test --workspace --locked --offline"]

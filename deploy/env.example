# Copy this file to .env beside compose.yaml and fill it in.

# The name the containers and volumes are grouped under.
COMPOSE_PROJECT_NAME=ros2ci

# The database password. Letters and digits only: it is placed in a URL.
CI_POSTGRES_PASSWORD=

# The container runtime's socket on this machine, for the worker container.
#   Docker:           /var/run/docker.sock
#   rootless Podman:  /run/user/<your uid>/podman/podman.sock
#                     (systemctl --user start podman.socket, or
#                      podman system service --time=0 &)
CI_RUNTIME_SOCKET=

# Where the worker API is published. The default is every address of this
# machine, port 8443. Use 127.0.0.1 to keep it to this machine.
#CI_WORKER_BIND=0.0.0.0
#CI_WORKER_PORT=8443

# The admin API is always published on 127.0.0.1 only.
#CI_ADMIN_PORT=8444
